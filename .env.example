# Copy to .env and fill in. .env is gitignored — never commit a key.
#
# Which engine to use. Default is mistral (free tier, no credit card).
#   mistral | claude | groq | openrouter | ollama | custom
SUBTRANS_PROVIDER=mistral

# Mistral — free "Experiment" tier, ~1B tokens/month: https://console.mistral.ai/
MISTRAL_API_KEY=

# Claude — paid, highest quality: https://console.anthropic.com/
#ANTHROPIC_API_KEY=

# Optional: override the provider's default model (see --list-models)
#SUBTRANS_MODEL=

# Only for SUBTRANS_PROVIDER=custom
#SUBTRANS_BASE_URL=
#SUBTRANS_API_KEY=
